{
  "name": "codrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "api:build": "npm run build --workspace @codrive/api",
    "api:start": "npm run start --workspace @codrive/api",
    "api:dev": "npm run dev --workspace @codrive/api",
    "db:start": "node scripts/start-mongo.mjs",
    "seed:billing": "node scripts/seed-demo-billing.mjs",
    "test:api": "npm run api:build && node --test tests/api.integration.mjs",
    "build:all": "npm run api:build && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "workspaces": [
    "backend"
  ]
}
