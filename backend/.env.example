# MongoDB (replica set required for transactions). Local default matches npm run db:start.
MONGODB_URI=mongodb://127.0.0.1:27018/fleetpro?replicaSet=fleetpro-rs

# HTTP bind (local). On Vercel, PORT is set by the platform; HOST can be omitted.
HOST=127.0.0.1
PORT=4000

# CORS origins for browser clients (comma-separated full origins).
CORS_ORIGINS=http://localhost:3017,http://127.0.0.1:3017,http://localhost:3000,http://127.0.0.1:3000

# Extra allowed Origin hosts for CSRF checks (comma-separated hosts, no scheme), e.g. preview.vercel.app
ALLOWED_ORIGINS=

# First admin bootstrap (only if no ADMIN with a password hash exists). Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public app URL used in invitation emails.
APP_URL=http://localhost:3017

# Optional SMTP for employee invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional n8n → billing OCR receipt stub (x-api-key header).
N8N_API_KEY=

# Optional Vercel Blob for expense justificatifs (frontend upload disabled until set).
BLOB_READ_WRITE_TOKEN=
